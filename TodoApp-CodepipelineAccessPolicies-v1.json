[
{
    "Version": "2012-10-17",    /* TodoApp-ElasticBeanstalkS3Access*/
    "Statement": [
        {
            "Sid": "Statement1",
            "Effect": "Allow",
            "Action": [
                "s3:GetBucketLocation",
                "s3:GetBucketVersioning",
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::elasticbeanstalk-us-east-1-<ACCOUNT-ID>"
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::elasticbeanstalk-us-east-1-<ACCOUNT-ID>/*"
        }
    ]
},


// TodoApp-ElasticBeanstalkCloudFormationAccess
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "Statement1",
            "Effect": "Allow",
            "Action": [
                "cloudformation:GetTemplate"
            ],
            "Resource": "arn:aws:cloudformation:us-east-1:<ACCOUNT-ID>:stack/*"
        }
    ]
},

// TodoApp-CodePipelineElasticBeanstalkDeploy
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "Statement1",
            "Effect": "Allow",
            "Action": [
                "elasticbeanstalk:DescribeApplicationVersions",
                "elasticbeanstalk:CreateApplicationVersion",
                "elasticbeanstalk:UpdateEnvironment",
                "elasticbeanstalk:DescribeEnvironments",
                "elasticbeanstalk:DescribeEvents"
            ],
            "Resource": "*"
        }
    ]
},

//TodoApp-CodePipeline-S3-bucket-permissions
{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:GetBucketVersioning"
            ],
            "Resource": [
                "arn:aws:s3:::todobeapp-codebuild-bucket",
                "arn:aws:s3:::todobeapp-codebuild-bucket/*"
            ]
        }
    ]
}

]